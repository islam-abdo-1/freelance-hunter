# Freelance Hunter - Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to git!

# ========================================
# Database (Required for production)
# Get from: Neon (neon.tech), Supabase, or Vercel Postgres
# ========================================
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# ========================================
# AIsa API Key (Optional - for enhanced search)
# Get from: https://aisa.one
# ========================================
AISA_API_KEY=sk-aisa-your-key-here

# ========================================
# Email/SMTP (For notifications)
# Use Gmail App Password (not regular password)
# Enable 2FA first: https://myaccount.google.com/security
# Then: Security > App Passwords > Create "Freelance Hunter"
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=true

# ========================================
# Notification Email (Where to send alerts)
# ========================================
NOTIFICATION_EMAIL=islam230366qw@gmail.com

# ========================================
# Vercel (Auto-filled after first deploy)
# Get from: Vercel Dashboard > Settings > Tokens
# ========================================
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_API_PROJECT_ID=
VERCEL_FRONTEND_PROJECT_ID=

# ========================================
# Application Settings
# ========================================
LOG_LEVEL=INFO
NEXT_PUBLIC_API_URL=https://your-api.vercel.app